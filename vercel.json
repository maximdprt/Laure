{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/massage-sportif", "destination": "/massage-sportif/index.html" },
    { "source": "/informations", "destination": "/informations/index.html" },
    { "source": "/reservation", "destination": "/reservation/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales/index.html" },
    { "source": "/politique-confidentialite", "destination": "/politique-confidentialite/index.html" },
    { "source": "/cgv", "destination": "/cgv/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    {
      "source": "/((?!sitemap\\.xml(?:/)?$|robots\\.txt(?:/)?$|llms\\.txt$|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/(favicon.ico|favicon-48x48.png|favicon-96x96.png|apple-touch-icon.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
